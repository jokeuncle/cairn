  "cards": [
    {
      "dot": "emerald",
      "title": "Cached query paths",
      "items": [
        "Section reads and lexical queries need no model call.",
        "Explicit Markdown links support local reverse paths, cycles and deletion reachability.",
        "Freshness checks hash originals; retrieved bodies come from the cache."
      ]
    },
    {
      "dot": "cyan",
      "title": "Model boundary",
      "items": [
        "Hybrid search is the default search strategy and needs a compatible query embedder.",
        "Index construction still builds summaries and document embeddings.",
        "Providers are configurable; cached queries do not imply free cold indexing."
      ]
    },
    {
      "dot": "amber",
      "title": "Experimental alpha",
      "items": [
        "ADR-0016 / ADR-0017 ship as experimental features in alpha 0.1.0a13.",
        "Link analysis excludes headings, code, HTML, external and unknown targets; fragments are not validated.",
        "Stable citations and completeness warnings remain mandatory; no commercial cost superiority claim."
      ]
    }
  ]
